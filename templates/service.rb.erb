# frozen_string_literal: true
# Generated by integrate from <%= ir["format"] %> <%= ir["version"] %>.
# Do not hand-edit mappings here — change the spec or .spacegen.yml and regenerate.

class Provider
  class <%= provider["class_name"] %> < BaseService
    BASE_URL = ENV.fetch("<%= provider["base_url_env"] %>", <%= provider["base_url"].inspect %>)

    def create_request(operation, request_method = "create")
<% create = endpoint("create") -%>
<% if create -%>
      payload = build_payout_payload(operation)
      headers = auth_headers
<% if create.dig("idempotency", "header") -%>
      headers[<%= create.dig("idempotency", "header").inspect %>] = operation.id
<% end -%>
      response = client.post("#{BASE_URL}<%= create["path"] %>", json: payload, headers: headers)
      parse_create_response(operation, response)
<% else -%>
      # TODO: эндпоинт create не выведен из спецификации
      failure(:unprocessable_entity, "not_inferred")
<% end -%>
<% if error_map.any? { |r| r["http"] == 429 } -%>
    rescue Provider::RateLimitError
      failure(:too_many_requests, "provider.rate_limit")
<% end -%>
<% if error_map.any? { |r| r["http"] == 401 } -%>
    rescue Provider::UnauthorizedError
      failure(:unauthorized, "provider.invalid_credentials")
<% end -%>
    end

    def fetch_status(operation)
<% fetch = endpoint("fetch") -%>
<% if fetch -%>
      response = client.get("#{BASE_URL}<%= interpolated_path(fetch["path"]) %>")
      map_status(response.body["status"])
<% else -%>
      # TODO: эндпоинт fetch не выведен из спецификации
      failure(:unprocessable_entity, "not_inferred")
<% end -%>
    end

    def process_callback(payload)
<% if webhook -%>
      verify_signature!(payload) # <%= webhook["algorithm"] %> из <%= webhook["header"] %>
      case payload[<%= (webhook["event_field"] || "event").inspect %>]
<% Array(webhook["events"]).each do |ev| -%>
<% if ev["action"] == "approve" -%>
      when <%= ev["provider_event"].inspect %> then approve_operation(payload[<%= ev["id_field"].inspect %>])
<% elsif ev["action"] == "reject" -%>
      when <%= ev["provider_event"].inspect %> then reject_operation(payload[<%= ev["id_field"].inspect %>], payload.dig("error", "code"))
<% end -%>
<% end -%>
      else failure(:unprocessable_entity, "unknown_event")
      end
<% else -%>
      # TODO: webhook не выведен из спецификации
      failure(:unprocessable_entity, "not_inferred")
<% end -%>
    end

    def check_conditions(operation, request_method)
      base_result = super
      return base_result if base_result.failed?
<% conditions.each do |cond| -%>
<% if cond["op"] == ">=" -%>
      return failure(:unprocessable_entity, <%= cond["error"].inspect %>) if <%= cond["field"] %> < <%= cond["value"].inspect %>
<% elsif cond["op"] == "<=" -%>
      return failure(:unprocessable_entity, <%= cond["error"].inspect %>) if <%= cond["field"] %> > <%= cond["value"].inspect %>
<% end -%>
<% end -%>
      success
    end

    private

    def build_payout_payload(operation)
      <%= payload_ruby %>
    end

    def parse_create_response(operation, response)
      body = response.body
      operation.provider_operation_id = body["id"] || body["payout_id"] || body["payment_id"]
      map_status(body["status"])
    end

    def map_status(provider_status)
      STATUS_MAP.fetch(provider_status.to_s) { "in_progress" }
    end

    def auth_headers
      <%= auth_header_ruby %>
    end
<% if webhook && webhook["header"] -%>

    def verify_signature!(payload)
      secret = ENV.fetch("<%= provider["name"].upcase %>_CALLBACK_SECRET")
      raw = payload.is_a?(String) ? payload : JSON.dump(payload)
<% if webhook["encoding"] == "base64" -%>
      digest = Base64.strict_encode64(OpenSSL::HMAC.digest("SHA256", secret, raw))
<% else -%>
      digest = OpenSSL::HMAC.hexdigest("SHA256", secret, raw)
<% end -%>
      provided = callback_signature(payload)
      return if provided.to_s != "" && OpenSSL.fixed_length_secure_compare(digest, provided)

      raise Provider::UnauthorizedError, "invalid webhook signature"
    end

    def callback_signature(payload)
      return payload["signature"] if payload.is_a?(Hash) && payload["signature"]
      return payload[<%= webhook["header"].inspect %>] if payload.is_a?(Hash)

      nil
    end
<% end -%>

    STATUS_MAP = <%= ruby_string_hash(status_map) %>

    ERROR_MAP = <%= ruby_error_hash %>
  end
end
